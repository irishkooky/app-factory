---
import BaseLayout from "~/layouts/base-layout.astro";
import { site } from "~/site.config";
---

<BaseLayout title={`ページが見つかりません｜${site.company.shortName}`}>
  <main class="mx-auto max-w-xl px-5 py-32 text-center">
    <p class="font-bold text-5xl text-brand">404</p>
    <p class="mt-4 text-stone-600">お探しのページは見つかりませんでした。</p>
    <a class="mt-8 inline-block rounded-full bg-brand px-6 py-3 font-semibold text-white" href="/">トップへ戻る</a>
  </main>
</BaseLayout>
