---
import { site } from "~/site.config";
import Section from "./section.astro";
---

<Section eyebrow="STRENGTH" id="strengths" title={`${site.company.shortName}が選ばれる理由`}>
  <ol class="grid gap-6 md:grid-cols-3">
    {
      site.strengths.map((item, i) => (
        <li class="border-brand border-t-2 pt-5">
          <span class="font-bold text-3xl text-brand">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-2 font-bold text-lg text-stone-900">{item.title}</h3>
          <p class="mt-2 text-sm text-stone-600 leading-relaxed">{item.description}</p>
        </li>
      ))
    }
  </ol>
</Section>
