---
import { site } from "~/site.config";
import Section from "./section.astro";

const { about } = site;
---

<Section eyebrow="ABOUT" id="about" title={about.title}>
  <div class="grid items-center gap-10 md:grid-cols-2">
    <p class="text-base text-stone-700 leading-loose sm:text-lg">{about.body}</p>
    {
      about.photo && (
        <img
          alt={about.photo.alt}
          class="aspect-[4/3] w-full rounded-2xl object-cover shadow-md"
          loading="lazy"
          src={about.photo.src}
        />
      )
    }
  </div>
</Section>
