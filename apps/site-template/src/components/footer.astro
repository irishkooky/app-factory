---
import { site } from "~/site.config";

const { company, contact } = site;
---

<footer class="bg-stone-900 text-stone-400">
  <div class="mx-auto max-w-6xl px-5 py-10 text-sm sm:px-8">
    <p class="font-bold text-base text-white">{company.name}</p>
    <p class="mt-2">{contact.postalCode && `〒${contact.postalCode} `}{contact.address}</p>
    <p class="mt-1">TEL {contact.phone}</p>
    <p class="mt-6 text-stone-500 text-xs">© {new Date().getFullYear()} {company.name}</p>
  </div>
</footer>
