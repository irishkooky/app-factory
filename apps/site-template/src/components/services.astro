---
import { site } from "~/site.config";
import Section from "./section.astro";
---

<Section eyebrow="SERVICE" id="services" soft title="サービス">
  <div class="grid gap-6 md:grid-cols-3">
    {
      site.services.map((service) => (
        <article class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
          {service.photo && (
            <img
              alt={service.photo.alt}
              class="aspect-[3/2] w-full object-cover"
              loading="lazy"
              src={service.photo.src}
            />
          )}
          <div class="p-6">
            <h3 class="font-bold text-lg text-stone-900">{service.title}</h3>
            <p class="mt-3 text-sm text-stone-600 leading-relaxed">{service.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</Section>
